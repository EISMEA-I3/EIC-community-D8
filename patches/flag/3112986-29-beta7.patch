diff --git a/src/Service/FlagFloodControlService.php b/src/Service/FlagFloodControlService.php
new file mode 100644
index 0000000..4653512
--- /dev/null
+++ b/src/Service/FlagFloodControlService.php
@@ -0,0 +1,85 @@
+<?php
+
+namespace Drupal\flag\Service;
+
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Flood\FloodInterface;
+use Drupal\Core\Session\AccountInterface;
+
+/**
+ * A service class for sending notifications of private messages.
+ */
+class FlagFloodControlService implements FlagFloodControlServiceInterface {
+
+  /**
+   * The currently logged in user.
+   *
+   * @var \Drupal\Core\Session\AccountInterface
+   */
+  protected $currentUser;
+
+  /**
+   * The entity type manager.
+   *
+   * @var \Drupal\Core\Entity\EntityFieldManagerInterface
+   */
+  protected $entityTypeManager;
+
+  /**
+   * The flood service.
+   *
+   * @var \Drupal\Core\Flood\FloodInterface
+   */
+  protected $flood;
+
+  /**
+   * CommentPager constructor.
+   *
+   * @param \Drupal\Core\Entity\EntityTypeManagerInterface $entityTypeManager
+   *   Entity type manager.
+   * @param \Drupal\Core\Session\AccountInterface $currentUser
+   *   The currently logged in user.
+   * @param \Drupal\Core\Flood\FloodInterface $flood
+   *   The flood control service.
+   */
+  public function __construct(
+    EntityTypeManagerInterface $entityTypeManager,
+    AccountInterface $currentUser,
+    FloodInterface $flood
+  ) {
+    $this->entityTypeManager = $entityTypeManager;
+    $this->currentUser = $entityTypeManager->getStorage('user')
+      ->load($currentUser->id());
+    $this->flood = $flood;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function allowed($flagId) {
+    $flag = $this->entityTypeManager->getStorage('flag')->load($flagId);
+    $identifier = $this->createIdentifier($flagId);
+    return !$flag->getFloodControlActive() ||
+      $this->flood->isAllowed('flag.flagging', $flag->getFloodControlLimit(), $flag->getFloodControlWindow(), $identifier) ||
+      $this->currentUser->hasPermission('bypass flagging flood control');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function register($flagId) {
+    $flag = $this->entityTypeManager->getStorage('flag')->load($flagId);
+    if ($flag->getFloodControlActive()) {
+      $identifier = $this->createIdentifier($flagId);
+      $this->flood->register('flag.flagging', $flag->getFloodControlWindow(), $identifier);
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function createIdentifier($flagId) {
+    return $this->currentUser->id() . '-' . $flagId;
+  }
+
+}
diff --git a/src/Service/FlagFloodControlServiceInterface.php b/src/Service/FlagFloodControlServiceInterface.php
new file mode 100644
index 0000000..d0b21a7
--- /dev/null
+++ b/src/Service/FlagFloodControlServiceInterface.php
@@ -0,0 +1,40 @@
+<?php
+
+namespace Drupal\flag\Service;
+
+/**
+ * Interface for the Private Message notification service.
+ */
+interface FlagFloodControlServiceInterface {
+
+  /**
+   * Checks is the current user is allowed to use a flag.
+   *
+   * @param int $flagId
+   *   The id of the flag.
+   *
+   * @return bool
+   *   True if allowed, false if not.
+   */
+  public function allowed($flagId);
+
+  /**
+   * Registers the current user to the flood api for a flag.
+   *
+   * @param int $flagId
+   *   The id of the flag.
+   */
+  public function register($flagId);
+
+  /**
+   * Returns an identifier based on the current user and flag id.
+   *
+   * @param int $flagId
+   *   The id of the flag.
+   *
+   * @return string
+   *   The constructed identifier.
+   */
+  public function createIdentifier($flagId);
+
+}
