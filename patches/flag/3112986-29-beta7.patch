+/**
+ * Set default flood control settings on all flags.
+ */
+function flag_update_8402() {
+  if ($flags = \Drupal::entityTypeManager()->getStorage('flag')->loadMultiple()) {
+    foreach ($flags as $flag) {
+      // Turn off flood control by default.
+      $flag->setFloodControlActive(FALSE);
+      $flag->setFloodControlLimit(0);
+      $flag->setFloodControlWindow(0);
+      $flag->save();
+    }
+  }
+}
